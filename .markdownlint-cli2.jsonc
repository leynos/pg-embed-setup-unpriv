{
  // File selection lives only here. markdownlint-cli2 appends this array to
  // any positional globs, so a caller that passes its own globs widens the
  // set instead of replacing it. The Makefile and the CI action therefore
  // pass none, and both lint exactly these files.
  "globs": ["**/*.md"],
  "gitignore": true,
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" }
  },
  "ignores": [
    "**/.venv/**",
    ".node_modules/**",
    "**/node_modules/**",
    "**/.uv-cache/**",
    "**/target/**",
    "**/execplans/**",
    ".vtcode/**",
    ".terraform/**",
    ".uv-cache/**",
    "memories/**",
    "CRUSH.md",
    "**/dist/**",
    "**/.uv-tools/**"
  ]
}
